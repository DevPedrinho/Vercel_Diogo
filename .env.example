# Credenciais do projeto Supabase do casamento (Settings → API).
# Copie para .env.local antes de rodar `npm run dev`, e cadastre as mesmas
# duas variáveis na Vercel (Settings → Environment Variables).
#
# As duas são públicas por natureza (vão para o navegador) — quem protege
# os dados são as políticas de RLS da migração em supabase/migrations.
#
# Sem elas o site abre em MODO DEMONSTRAÇÃO: textos padrão, presentes de
# exemplo e o painel aberto só para olhar, sem salvar nada.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: URL pública do site, usada na imagem de compartilhamento.
NEXT_PUBLIC_SITE_URL=
